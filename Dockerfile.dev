# Backend development image. Source code is mounted by docker-compose.dev.yml,
# so normal Go changes reuse the persistent module and build caches instead of
# rebuilding an application image.
FROM golang:1.26.1-alpine

ENV GO111MODULE=on \
    CGO_ENABLED=0 \
    GOEXPERIMENT=greenteagc \
    GOCACHE=/go-build-cache \
    GOMODCACHE=/go-module-cache \
    GOPROXY=https://goproxy.cn,direct

WORKDIR /workspace

COPY go.mod go.sum ./
COPY relaykit/go.mod ./relaykit/go.mod
RUN go mod download
