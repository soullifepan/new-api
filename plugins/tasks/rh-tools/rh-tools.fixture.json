              "targetResolution": "3k",
              "duration_seconds": 1
            }
          }
        }
      ],
      "expectedError": "targetResolution must be one of"
    },
    {
      "name": "rejects insecure URL",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "volc-subtitle-erase/video",
              "videoUrl": "http://media.example/a.mp4",
              "duration_seconds": 1
            }
          }
        }
      ],
      "expectedError": "videoUrl must be an absolute https URL"
    },
    {
      "name": "rejects stem duration",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "mureka-ai/stem-song",
              "url": "https://media.example/a.mp3",
              "rh_model": "audio-separation-1",
              "duration_seconds": 1
            }
          }
        }
      ],
      "expectedError": "duration_seconds is not supported"
    },
    {
      "name": "requires duration",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "volc-subtitle-erase/video",
              "videoUrl": "https://media.example/a.mp4"
            }
          }
        }
      ],
      "expectedError": "duration_seconds must be"
