          }
        }
      ],
      "expected": {
        "url": "https://www.runninghub.cn/openapi/v2/mureka-ai/stem-song",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer key"
        },
        "body": {
          "url": "https://media.example/a.mp3",
          "model": "audio-separation-1"
        },
        "action": "rh_tool"
      }
    },
    {
      "name": "builds upscaler request",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "rhart-video/video-upscaler",
          "baseUrl": "https://www.runninghub.cn",
          "apiKey": "key",
