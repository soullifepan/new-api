    {
      "name": "lists zip artifact",
      "hook": "listArtifacts",
      "args": [
        {
          "status": "SUCCESS",
          "data": {
            "results": [
              {
                "url": "https://cdn.example/result.zip",
                "outputType": "zip"
              }
            ]
          }
        }
      ],
      "expected": [
        {
          "key": "output-0",
          "type": "file",
          "mimeType": "application/zip"
        }
      ]
    },
    {
      "name": "builds mp4 artifact content",
      "hook": "buildContentRequest",
      "args": [
        {
          "status": "SUCCESS",
          "artifactKey": "output-0",
          "clientRequest": {
            "method": "GET"
          },
          "data": {
            "results": [
              {
                "url": "https://cdn.example/result.mp4",
                "outputType": "mp4"
              }
            ]
          }
        }
      ],
      "expected": {
        "url": "https://cdn.example/result.mp4",
        "method": "GET",
        "credentialless": true
      }
    },
    {
      "name": "rejects invalid artifact key",
      "hook": "buildContentRequest",
      "args": [
        {
          "status": "SUCCESS",
          "artifactKey": "bad",
          "data": {
            "results": []
          }
        }
      ],
      "expectedError": "artifact_not_found"
    },
    {
      "name": "renders success without usage fields",
      "hook": "native",
      "member": "renderTask",
      "args": [
        {},
        {
          "task_id": "x",
          "status": "SUCCESS",
          "data": {
            "status": "SUCCESS",
            "usage": {
              "thirdPartyConsumeMoney": "0.1"
            },
            "taskUsageList": [],
            "results": []
          }
        }
      ],
      "expected": {
        "task_id": "x",
        "status": "SUCCESS",
        "progress": "",
        "fail_reason": "",
        "data": {
          "status": "SUCCESS",
          "results": []
        },
        "artifact_metadata": {
          "source": "RunningHub temporary result URL"
        }
      }
    },
    {
      "name": "turns S0 rejection into immediate failure",
      "hook": "parseSubmitResponse",
      "args": [
        {
          "publicTaskId": "fixture-rejection"
        },
        {
          "body": {
            "taskId": "",
            "status": "",
            "errorCode": "40310",
            "errorMessage": "Model unavailable",
            "results": null,
            "clientId": "",
            "promptTips": "",
            "failedReason": {},
            "usage": null,
            "parentTaskId": null,
            "taskUsageList": null
          }
        }
      ],
      "expected": {
        "taskId": "rh-rejected-fixture-rejection",
        "taskData": {
          "taskId": "",
          "status": "",
          "errorCode": "40310",
          "errorMessage": "Model unavailable",
          "results": null,
          "clientId": "",
          "promptTips": "",
          "failedReason": {},
          "usage": null,
          "parentTaskId": null,
          "taskUsageList": null
        },
        "immediate": {
          "status": "FAILURE",
          "reason": "RunningHub error 40310: Model unavailable"
        }
      }
    },
