{
  "cases": [
    {
      "name": "builds subtitle erase request without envelope fields",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "volc-subtitle-erase/video",
          "baseUrl": "https://www.runninghub.cn",
          "apiKey": "key",
          "requestBody": {
            "videoUrl": "https://media.example/a.mp4",
            "duration_seconds": 12.4
          }
        }
      ],
      "expected": {
        "url": "https://www.runninghub.cn/openapi/v2/volc-subtitle-erase/video",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer key"
        },
        "body": {
          "videoUrl": "https://media.example/a.mp4"
        },
        "action": "rh_tool"
      }
    },
    {
      "name": "builds subtitle erase pro request",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "volc-subtitle-erase-pro/video",
          "baseUrl": "https://www.runninghub.cn",
          "apiKey": "key",
          "requestBody": {
            "videoUrl": "https://media.example/a.mp4",
            "eraseType": "subtitle",
            "encodeMode": "quality",
            "duration_seconds": 10
          }
        }
      ],
      "expected": {
        "url": "https://www.runninghub.cn/openapi/v2/volc-subtitle-erase-pro/video",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer key"
        },
        "body": {
          "videoUrl": "https://media.example/a.mp4",
          "eraseType": "subtitle",
          "encodeMode": "quality"
        },
        "action": "rh_tool"
      }
    },
    {
