    {
      "name": "keeps a RunningHub submission task",
      "hook": "parseSubmitResponse",
      "args": [
        {},
        {
          "body": {
            "taskId": "task-submit",
            "status": "CREATE",
            "results": null
          }
        }
      ],
      "expected": {
        "taskId": "task-submit",
        "taskData": {
          "taskId": "task-submit",
          "status": "CREATE",
          "results": null
        }
      }
    },
    {
      "name": "maps create",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "taskId": "x",
          "status": "CREATE"
        }
      ],
      "expected": {
        "status": "QUEUED",
        "progress": ""
      }
    },
    {
      "name": "maps queued",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "taskId": "x",
          "status": "QUEUED"
        }
      ],
      "expected": {
        "status": "QUEUED",
        "progress": ""
      }
    },
    {
      "name": "maps running",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "taskId": "x",
          "status": "RUNNING"
        }
      ],
      "expected": {
        "status": "IN_PROGRESS",
        "progress": ""
      }
    },
    {
      "name": "maps failed",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "taskId": "x",
          "status": "FAILED",
          "errorCode": "BAD"
        }
      ],
      "expected": {
        "status": "FAILURE",
        "progress": "100%",
        "reason": "BAD"
      }
    },
    {
      "name": "maps cancel",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "taskId": "x",
          "status": "CANCEL"
        }
      ],
      "expected": {
        "status": "FAILURE",
        "progress": "100%",
        "reason": "RunningHub task failed"
      }
    },
    {
      "name": "maps zip success",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "taskId": "x",
          "status": "SUCCESS",
          "results": [
            {
              "url": "https://cdn.example/result.zip",
              "outputType": "zip"
            }
          ]
        }
      ],
      "expected": {
        "status": "SUCCESS",
        "progress": "100%",
        "reason": ""
      }
    },
    {
      "name": "maps missing success outputs",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "taskId": "x",
          "status": "SUCCESS",
          "results": null
        }
      ],
      "expected": {
        "status": "UNKNOWN",
        "reason": "RunningHub success response is missing a result URL"
      }
    },
    {
      "name": "estimates subtitle erase",
      "hook": "extractUsage",
      "args": [
        {
          "model": "volc-subtitle-erase/video",
          "requestBody": {
            "videoUrl": "https://media.example/a.mp4",
            "duration_seconds": 12.4
          }
        }
      ],
      "expected": {
        "upstream_cny": 0.062
      }
    },
    {
      "name": "estimates 4k upscale",
      "hook": "extractUsage",
      "args": [
        {
          "model": "rhart-video/video-upscaler",
          "requestBody": {
            "videoUrl": "https://media.example/a.mp4",
