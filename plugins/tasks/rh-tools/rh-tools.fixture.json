            "videoUrl": "https://media.example/a.mp4",
            "targetResolution": "2k",
            "duration_seconds": 10
          }
        }
      ],
      "expected": {
        "url": "https://www.runninghub.cn/openapi/v2/rhart-video/video-upscaler",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer key"
        },
        "body": {
          "videoUrl": "https://media.example/a.mp4",
          "targetResolution": "2k"
        },
        "action": "rh_tool"
      }
    },
    {
      "name": "rejects unknown field",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "volc-subtitle-erase/video",
              "videoUrl": "https://media.example/a.mp4",
              "duration_seconds": 1,
              "extra": true
            }
          }
        }
      ],
      "expectedError": "unsupported field"
    },
    {
      "name": "rejects clientToken",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "volc-subtitle-erase/video",
              "videoUrl": "https://media.example/a.mp4",
              "duration_seconds": 1,
              "clientToken": "x"
            }
          }
        }
      ],
      "expectedError": "unsupported field"
    },
    {
      "name": "rejects invalid list",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "rhart-video/video-upscaler",
