    {
      "name": "bounds upscaler duration",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "rhart-video/video-upscaler",
              "videoUrl": "https://media.example/a.mp4",
              "targetResolution": "720p",
              "duration_seconds": 601
