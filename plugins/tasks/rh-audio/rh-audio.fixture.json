{
  "cases": [
    {
      "name": "constructs the confirmed Qwen TTS request",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "qwen3-tts-flash",
          "upstreamModel": "qwen3-tts-flash",
          "baseUrl": "https://www.runninghub.cn",
          "apiKey": "fixture-channel-key",
          "requestBody": {
            "text": "Hello from the fixture",
            "voice": "Cherry",
            "languageType": "Auto"
          }
        }
      ],
      "expected": {
        "url": "https://www.runninghub.cn/openapi/v2/alibaba/qwen3-tts-flash",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer fixture-channel-key"
        },
        "body": {
          "text": "Hello from the fixture",
          "voice": "Cherry",
          "languageType": "Auto"
        },
        "action": "audio_generation"
      }
    },
    {
      "name": "constructs the documented MiniMax Speech 2.8 HD request",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "minimax/speech-2.8-hd",
          "upstreamModel": "minimax/speech-2.8-hd",
          "baseUrl": "https://www.runninghub.cn",
          "apiKey": "fixture-channel-key",
          "requestBody": {
            "text": "Hello from the fixture",
            "pronunciation_dict": "ASAP/As soon as possible",
            "voice_id": "Wise_Woman",
            "speed": 1,
            "volume": 1,
            "pitch": 0,
            "emotion": "happy",
            "enable_base64_output": false,
            "english_normalization": false
          }
        }
      ],
      "expected": {
        "url": "https://www.runninghub.cn/openapi/v2/rhart-audio/text-to-audio/speech-2.8-hd",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer fixture-channel-key"
        },
        "body": {
          "text": "Hello from the fixture",
          "pronunciation_dict": "ASAP/As soon as possible",
          "voice_id": "Wise_Woman",
          "speed": 1,
          "volume": 1,
          "pitch": 0,
          "emotion": "happy",
          "enable_base64_output": false,
          "english_normalization": false
        },
        "action": "audio_generation"
      }
    },
    {
      "name": "accepts MiniMax voice IDs outside the official system list",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "minimax/speech-2.8-hd",
              "text": "narrator",
              "voice_id": "Cantonese_ProfessionalHost（F)"
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "minimax/speech-2.8-hd",
        "action": "audio_generation",
        "requestBody": {
          "text": "narrator",
          "voice_id": "Cantonese_ProfessionalHost（F)",
          "enable_base64_output": false,
          "english_normalization": false
        }
      }
    },
    {
      "name": "rejects a MiniMax voice ID with control characters",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "minimax/speech-2.8-hd",
              "text": "narrator",
              "voice_id": "Chinese (Mandarin)_Reliable\nExecutive"
            }
          }
        }
      ],
      "expectedError": "voice_id must not contain control characters"
    },
    {
      "name": "rejects a MiniMax voice ID longer than 128 characters",
      "hook": "native",
      "member": "decodeSubmit",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "minimax/speech-2.8-hd",
              "text": "narrator",
              "voice_id": "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
            }
          }
        }
      ],
      "expectedError": "voice_id must be a non-empty string of at most 128 characters"
    },
    {
