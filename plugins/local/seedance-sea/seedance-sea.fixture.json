{
  "cases": [
    {
      "name": "maps the SEA Fast alias to Token0A and preserves explicit false",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "doubao-seedance-2-0-fast-sea",
          "baseUrl": "https://seedance.0a.com",
          "apiKey": "fixture-key",
          "requestBody": {
            "metadata": {
              "model": "doubao-seedance-2-0-fast-sea",
              "content": [
                {
                  "type": "text",
                  "text": "cat"
                }
              ],
              "duration": 4,
              "resolution": "1080p",
              "watermark": false,
              "generate_audio": false
            }
          }
        }
      ],
      "expected": {
        "url": "https://seedance.0a.com/api/token/v3/contents/generations/tasks",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer fixture-key"
        },
        "body": {
          "model": "doubao-seedance-2-0-fast-260128",
          "content": [
            {
              "type": "text",
              "text": "cat"
            }
          ],
          "duration": 4,
          "resolution": "1080p",
          "watermark": false,
          "generate_audio": false,
          "ratio": "adaptive"
        },
        "action": "text_to_video"
      }
    },
    {
      "name": "rejects 1080p for Token0A Seedance 2.5",
      "hook": "native",
      "member": "createTask",
      "args": [
        {
          "body": {
