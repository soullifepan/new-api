      "expected": {
        "kind": "submit",
        "model": "doubao-seedance-2-0-sea",
        "action": "text_to_video",
        "requestBody": {
          "model": "doubao-seedance-2-0-sea",
          "metadata": {
            "model": "doubao-seedance-2-0-sea",
            "content": [
              {
                "type": "text",
                "text": "cat"
              }
            ],
            "duration": 5,
            "resolution": "720p"
          }
