    {
      "name": "decode multi media registration",
      "hook": "native",
      "args": [
        {
          "path": "/seedance-sea/v7/asset/createMedia",
          "body": {
            "kind": "json",
            "value": {
              "url": "https://media.example/cat.png",
              "name": "cat",
              "assetType": "Image"
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "doubao-seedance-2-0-sea",
        "action": "createMedia",
        "requestBody": {
          "url": "https://media.example/cat.png",
          "name": "cat",
          "assetType": "Image"
        }
      },
      "member": "createAsset"
    },
    {
      "name": "createMedia uses Token0A casing and URL",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "doubao-seedance-2-0-sea",
          "baseUrl": "https://seedance.0a.com",
          "apiKey": "fixture-key",
          "action": "createMedia",
          "requestBody": {
            "url": "https://media.example/cat.png",
            "name": "cat",
            "assetType": "Image"
          }
        }
      ],
      "expected": {
        "url": "https://seedance.0a.com/api/token/v7/asset/createMedia",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer fixture-key"
        },
        "body": {
          "url": "https://media.example/cat.png",
          "name": "cat",
          "assetType": "Image"
        },
        "action": "createMedia"
      }
    },
    {
      "name": "created asset is polled to Active",
      "hook": "parseSubmitResponse",
      "args": [
        {
          "action": "createMedia"
        },
        {
          "body": {
            "id": "asset-private"
          }
        }
      ],
      "expected": {
        "taskId": "asset-private",
        "taskData": {
          "Id": "asset-private"
        }
      }
    },
    {
      "name": "asset polling uses GET with an encoded id",
      "hook": "buildQueryRequest",
      "args": [
        {
          "model": "doubao-seedance-2-0-sea",
          "baseUrl": "https://seedance.0a.com",
          "apiKey": "fixture-key",
          "action": "createMedia",
          "taskId": "asset-private"
        }
      ],
      "expected": {
        "url": "https://seedance.0a.com/api/token/v7/asset/get?id=asset-private",
        "method": "GET",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer fixture-key"
        }
      }
    },
    {
      "name": "asset Active",
      "hook": "parseTaskResult",
      "args": [
        {
          "action": "createMedia"
        },
        {
          "Status": "Active",
          "errorMessage": "rejected"
        }
      ],
      "expected": {
        "status": "SUCCESS",
        "progress": "100%"
      }
    },
    {
      "name": "asset Processing",
      "hook": "parseTaskResult",
      "args": [
        {
          "action": "createMedia"
        },
        {
          "Status": "Processing",
          "errorMessage": "rejected"
        }
      ],
      "expected": {
        "status": "IN_PROGRESS",
        "progress": "50%"
      }
    },
    {
      "name": "asset Failed",
      "hook": "parseTaskResult",
      "args": [
        {
          "action": "createMedia"
        },
        {
          "Status": "Failed",
          "errorMessage": "rejected"
        }
      ],
      "expected": {
        "status": "FAILURE",
        "progress": "100%",
        "reason": "rejected"
      }
    },
    {
      "name": "asset Unknown",
      "hook": "parseTaskResult",
      "args": [
        {
          "action": "createMedia"
        },
        {
          "Status": "Unknown",
          "errorMessage": "rejected"
        }
      ],
      "expected": {
        "status": "UNKNOWN",
        "reason": "unrecognized asset status"
      }
    },
    {
      "name": "successful task uses documented total_tokens",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "status": "succeeded",
          "usage": {
            "total_tokens": 123,
            "completion_tokens": 100
          }
        }
      ],
      "expected": {
        "status": "SUCCESS",
        "progress": "100%",
        "totalTokens": 123
      }
    },
    {
      "name": "reject missing or invalid completion usage 30",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "status": "succeeded",
          "usage": {}
        }
      ],
      "expectedError": "missing or invalid usage.total_tokens"
    },
    {
      "name": "reject missing or invalid completion usage 31",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "status": "succeeded",
          "usage": {
            "total_tokens": null
          }
        }
      ],
      "expectedError": "missing or invalid usage.total_tokens"
    },
    {
      "name": "reject missing or invalid completion usage 32",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "status": "succeeded",
          "usage": {
            "total_tokens": -1
          }
        }
      ],
      "expectedError": "missing or invalid usage.total_tokens"
    },
    {
      "name": "reject missing or invalid completion usage 33",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "status": "succeeded",
          "usage": {
            "total_tokens": "123"
          }
        }
      ],
      "expectedError": "missing or invalid usage.total_tokens"
    },
    {
      "name": "reject missing or invalid completion usage 34",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "status": "succeeded",
          "usage": {
            "total_tokens": 2147483648
          }
        }
      ],
      "expectedError": "missing or invalid usage.total_tokens"
    },
    {
      "name": "settle total tokens including explicit zero",
      "hook": "extractUsageOnComplete",
      "args": [
        {},
        {
          "status": "SUCCESS"
        },
        {
          "usage": {
            "total_tokens": 0,
            "completion_tokens": 100
          }
        }
      ],
      "expected": {
        "tokens": 0
      }
    },
    {
      "name": "assets have no video consumption",
      "hook": "extractUsage",
      "args": [
        {
          "action": "createMedia"
        }
      ],
      "expected": {
        "tokens": 0,
        "resolution": "720p",
        "video_input": "none"
      }
    },
    {
      "name": "video response keeps gateway task id",
      "hook": "native",
      "args": [
        {},
        {
          "task_id": "task_video",
          "data": {
            "id": "cgt-wt-private",
            "status": "succeeded",
            "content": {
              "video_url": "https://media.example/video.mp4"
            },
            "usage": {
              "total_tokens": 123
            }
          }
        }
      ],
      "expected": {
        "id": "task_video",
        "status": "succeeded",
        "content": {
          "video_url": "https://media.example/video.mp4"
        },
        "usage": {
          "total_tokens": 123
        }
      },
      "member": "taskStatus"
    },
    {
      "name": "query uses original native asset id",
      "hook": "native",
      "member": "getAsset",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": { "id": "asset-native" }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "doubao-seedance-2-0-sea",
        "action": "get",
        "requestBody": {
          "id": "asset-native"
        }
      }
    },
    {
      "name": "native asset lookup goes to Token0A",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "doubao-seedance-2-0-sea",
          "action": "get",
          "baseUrl": "https://seedance.0a.com",
          "apiKey": "fixture-key",
          "requestBody": {
            "id": "asset-native"
          }
        }
      ],
      "expected": {
        "url": "https://seedance.0a.com/api/token/v7/asset/get?id=asset-native",
        "method": "GET",
        "body": "",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer fixture-key"
        }
      }
    },
    {
      "name": "created asset returns native id, never task id",
      "hook": "native",
      "member": "assetCreated",
      "args": [
        {},
        {
          "task_id": "task_gateway",
          "data": {
            "Id": "asset-native",
            "Status": "Processing"
          }
        }
      ],
      "expected": {
        "id": "asset-native",
        "Status": "Processing"
      }
    },
    {
      "name": "lookup preserves native status and failure details",
      "hook": "parseSubmitResponse",
      "args": [
        {
          "action": "get",
          "publicTaskId": "task_lookup"
        },
        {
          "body": {
            "id": "asset-native",
            "Status": "Failed",
            "Error": {
              "Message": "rejected"
            }
          }
        }
      ],
      "expected": {
        "taskId": "task_lookup",
        "taskData": {
          "id": "asset-native",
          "Status": "Failed",
          "Error": {
            "Message": "rejected"
          }
        },
        "immediate": {
          "status": "SUCCESS",
          "progress": "100%"
        }
      }
    },
    {
      "name": "passes native asset reference to video unchanged",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "doubao-seedance-2-0-sea",
          "baseUrl": "https://seedance.0a.com",
          "apiKey": "fixture-key",
          "requestBody": {
            "metadata": {
              "content": [
                {
                  "type": "image_url",
                  "image_url": {
                    "url": "asset://asset-native"
                  }
                }
              ]
            }
          }
        }
      ],
      "expected": {
        "url": "https://seedance.0a.com/api/token/v3/contents/generations/tasks",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer fixture-key"
        },
        "body": {
          "model": "doubao-seedance-2-0-260128",
          "content": [
            {
              "type": "image_url",
              "image_url": {
                "url": "asset://asset-native"
              }
            }
          ],
          "duration": 5,
          "resolution": "720p"
        },
        "action": "image_to_video"
      }
    }
