{
  "cases": [
    {
      "name": "accepts a documented image generation request",
      "hook": "native",
      "member": "decodeImageGeneration",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "gpt-image-2",
              "prompt": "a ginger cat at sunset",
              "size": "16:9",
              "resolution": "2k",
              "n": 1
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "gpt-image-2",
        "action": "image_generation",
        "requestBody": {
          "model": "gpt-image-2",
          "prompt": "a ginger cat at sunset",
          "size": "16:9",
          "resolution": "2k",
          "n": 1
        }
      }
    },
    {
      "name": "builds the documented APIMart submit request",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.apib.ai",
          "apiKey": "test-token",
          "model": "gpt-image-2",
          "requestBody": {
            "model": "gpt-image-2",
            "prompt": "a ginger cat at sunset",
            "size": "16:9",
            "resolution": "2k",
            "n": 1
          }
        }
      ],
      "expected": {
        "url": "https://api.apib.ai/v1/images/generations",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer test-token"
        },
        "body": {
          "model": "gpt-image-2",
          "prompt": "a ginger cat at sunset",
          "size": "16:9",
          "resolution": "2k",
          "n": 1
        },
        "action": "image_generation"
      }
    },
    {
      "name": "uses the mapped upstream model for the APIMart request",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.apib.ai",
          "apiKey": "test-token",
          "model": "gpt-image-2-am",
          "upstreamModel": "gpt-image-2",
          "requestBody": {
            "model": "gpt-image-2-am",
            "prompt": "a ginger cat at sunset",
            "n": 1
          }
        }
      ],
      "expected": {
        "url": "https://api.apib.ai/v1/images/generations",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer test-token"
        },
        "body": {
          "model": "gpt-image-2",
          "prompt": "a ginger cat at sunset",
          "n": 1
        },
        "action": "image_generation"
      }
    },
    {
      "name": "accepts the public APIMart model alias",
      "hook": "native",
      "member": "decodeImageGeneration",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "gpt-image-2-am",
              "prompt": "a ginger cat at sunset",
              "n": 1
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "gpt-image-2-am",
        "action": "image_generation",
        "requestBody": {
          "model": "gpt-image-2-am",
          "prompt": "a ginger cat at sunset",
          "n": 1
        }
      }
    },
    {
      "name": "accepts the official GPT Image 2 public alias",
      "hook": "native",
      "member": "decodeImageGeneration",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "gpt-image-2-official-am",
              "prompt": "a ginger cat at sunset",
              "resolution": "2k",
              "quality": "medium",
              "n": 2,
              "image_urls": ["https://example.test/a.png", "https://example.test/b.png"]
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "gpt-image-2-official-am",
        "action": "image_generation",
        "requestBody": {
          "model": "gpt-image-2-official-am",
          "prompt": "a ginger cat at sunset",
          "resolution": "2k",
          "quality": "medium",
          "n": 2,
          "image_urls": ["https://example.test/a.png", "https://example.test/b.png"]
        }
      }
    },
    {
      "name": "extracts billing facts from image count and resolution",
      "hook": "extractUsage",
      "args": [
        {
          "requestBody": {
            "model": "gpt-image-2-am",
            "resolution": "2K",
            "n": 3
          }
        }
      ],
      "expected": {"images": 3, "resolution": "2k"}
    },
    {
      "name": "uses the default pricing tier for an omitted resolution",
      "hook": "extractUsage",
      "args": [{"requestBody": {"model": "gpt-image-2-am"}}],
      "expected": {"images": 1, "resolution": "default"}
    },
    {
      "name": "estimates official GPT Image 2 credits before submission",
      "hook": "extractUsage",
      "args": [
        {
          "model": "gpt-image-2-official-am",
          "upstreamModel": "gpt-image-2-official",
          "requestBody": {
            "model": "gpt-image-2-official-am",
            "resolution": "2K",
            "quality": "medium",
            "n": 2,
            "image_urls": ["https://example.test/a.png", "https://example.test/b.png"]
          }
        }
      ],
      "expected": {"images": 2, "resolution": "2k", "upstream_credits": 2.448}
    },
    {
      "name": "settles official GPT Image 2 with the completed upstream credit deduction",
      "hook": "extractUsageOnComplete",
      "args": [
        {"model": "gpt-image-2-official-am", "upstreamModel": "gpt-image-2-official"},
        {},
        {"code": 200, "data": {"status": "completed", "credits_cost": 0.04792}}
      ],
      "expected": {"upstream_credits": 0.04792}
    },
    {
      "name": "zeros the official GPT Image 2 credit charge when the task fails",
      "hook": "extractUsageOnComplete",
      "args": [
        {"model": "gpt-image-2-official-am", "upstreamModel": "gpt-image-2-official"},
        {},
        {"code": 200, "data": {"status": "failed"}}
      ],
      "expected": {"upstream_credits": 0}
    },
    {
      "name": "rejects an implausible completed upstream credit deduction",
      "hook": "extractUsageOnComplete",
      "args": [
        {"model": "gpt-image-2-official-am", "upstreamModel": "gpt-image-2-official"},
        {},
        {"code": 200, "data": {"status": "completed", "credits_cost": 65}}
      ],
      "expected": null
    },
    {
      "name": "extracts the upstream task id from a successful submission",
      "hook": "parseSubmitResponse",
      "args": [
        {},
        {
          "body": {
            "code": 200,
            "data": [{"status": "submitted", "task_id": "task_upstream_1"}]
          }
        }
      ],
      "expected": {
        "taskId": "task_upstream_1",
        "taskData": {
          "code": 200,
          "data": [{"status": "submitted", "task_id": "task_upstream_1"}]
        }
      }
    },
    {
      "name": "converts a completed APIMart task to a gateway success",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "code": 200,
          "data": {
            "id": "task_upstream_1",
            "status": "completed",
            "progress": 100,
            "result": {"images": [{"url": ["https://upload.apimart.ai/image.png"]}]}
          }
        }
      ],
      "expected": {"status": "SUCCESS", "progress": "100%", "reason": ""}
    },
    {
      "name": "keeps unknown provider states retryable",
      "hook": "parseTaskResult",
      "args": [{}, {"code": 200, "data": {"status": "waiting_for_human"}}],
      "expected": {"status": "UNKNOWN", "reason": "unrecognized APIMart task status: waiting_for_human"}
    },
    {
      "name": "rejects a request above the documented image count",
      "hook": "native",
      "member": "decodeImageGeneration",
      "args": [{"body": {"kind": "json", "value": {"model": "gpt-image-2", "prompt": "cat", "n": 5}}}],
      "expectedError": "n must be an integer between 1 and 4"
    }
  ]
}
