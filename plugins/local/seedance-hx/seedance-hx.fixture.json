              "Error": {
                "Code": "ResourceNotFound"
              }
            }
          }
        }
      ],
      "expected": {
        "taskId": "task_lookup",
        "taskData": {
          "Result": {
            "Error": {
              "Code": "ResourceNotFound"
            }
          }
        },
        "immediate": {
          "status": "FAILURE",
          "reason": "ResourceNotFound"
        }
      }
